{
  "name": "ai-post-generator-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix mobile",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:mobile\"",
    "dev:server": "npm run dev --prefix server",
    "dev:mobile": "npm run start --prefix mobile",
    "start:server": "npm start --prefix server",
    "start:mobile": "npm run start --prefix mobile"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
